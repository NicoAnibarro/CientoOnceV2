PORT=3000
NODE_ENV=development
# Mantener false mientras el hosting no disponga de correo transaccional por HTTPS.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_DELIVERY_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Opcional: certificado CA de Aiven codificado en Base64.
DB_CA_CERT_BASE64=
JWT_SECRET=cambiar_por_un_secreto_largo
JWT_EXPIRES_IN=7d
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=12000
CORS_ORIGIN=*
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_CLOUD_PROJECT_ID=
# En producción: JSON de la cuenta de servicio codificado en Base64.
# En desarrollo también puede usarse GOOGLE_APPLICATION_CREDENTIALS con una ruta local.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GEMINI_API_KEY=
GEMINI_TICKET_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PUBLIC_API_URL=https://ciento-once-v2-api.onrender.com/api
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cuenta@gmail.com
# Usa una contraseña de aplicación de Google, nunca la contraseña normal.
SMTP_PASS=
MAIL_FROM=Ciento Once <cuenta@gmail.com>
PRIVACY_EMAIL=cientoonce2026@gmail.com
